{
  "name": "md2wechatmp",
  "version": "0.1.0",
  "private": true,
  "description": "Markdown 转微信公众号行内样式 HTML（图片直出 + 视频占位 + 一键复制）",
  "author": "md2wechatmp",
  "main": "./out/main/index.js",
  "scripts": {
    "icons": "node scripts/build-icons.cjs",
    "icons:check": "node scripts/build-icons.cjs --check",
    "test:icons": "node --test tests/node/icons.test.cjs",
    "test:installer": "node --test tests/node/installer-dpi.test.cjs",
    "prebuild": "npm run icons",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && electron-vite build",
    "test": "vitest run",
    "test:electron": "npm run build && node scripts/run-electron-regressions.cjs",
    "test:watch": "vitest",
    "compile:fixture": "vite-node scripts/compile-fixture.mts",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.11.3",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.0",
    "@resvg/resvg-wasm": "2.6.2",
    "@types/css-tree": "^3.2.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "codemirror": "^6.0.2",
    "css-tree": "^3.2.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "juice": "^12.2.0",
    "mathjax-full": "^3.2.1",
    "mdast-util-to-string": "^4.0.0",
    "parse5": "^8.0.1",
    "pngjs": "7.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "shiki": "^4.5.0",
    "typescript": "^5.7.0",
    "unified": "^11.0.5",
    "vite": "^8.3.5",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.1.0",
    "zod": "^4.6.7"
  }
}
